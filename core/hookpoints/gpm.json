    {
      "id": "gpm.navigation_status",
      "kind": "class",
      "find": {
        "name": "com.google.android.projection.protocol.NavigationStatus"
      }
    },
    {
      "id": "gpm.navigation_status.init",
      "kind": "method",
      "of": "gpm.navigation_status",
      "find": {
        "name": "init",
        "params": [
          "int",
          "long",
          "int",
          "com.google.android.projection.proto.Protos$NavigationStatusService$InstrumentClusterType",
          "int",
          "int",
          "int"
        ],
        "ret": "boolean"
      },
      "about": "tells the phone what the cluster takes: IMAGE (pictures) or ENUM (turn data)"
    },
    {
