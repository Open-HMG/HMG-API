#!/system/bin/sh
# HMG-API's USB installer, for a head unit with nothing installed yet (NEMESIS not
# needed). Engineering Mode > USB Copy > DSP > Update OTA extracts ota_package.tar
# from the stick and runs this as root, before it checks for a signed update (it
# then shows error 684: expected, nothing is undone). Works on the HMGAPI folder of
# the same stick:
#   HMGAPI/install/payload/   install, or update an installed HMG-API
#   HMGAPI/UNINSTALL          uninstall instead (HMGAPI/UNINSTALL-PURGE: also /data/hmgapi)
# Copies its log to HMGAPI/install.log, shows the result, and restarts the unit.
# Toolbox and mksh only: the unit has no busybox. ROOT and HMGAPI_USB_DIRS: off-car tests.
export PATH=/sbin:/vendor/bin:/system/sbin:/system/bin:/system/xbin${PATH:+:$PATH}
export LD_LIBRARY_PATH=/vendor/lib:/system/lib
umask 077
# Engineering Mode (the DSP agent) runs this with its output on a pipe. If that screen closes
# while it runs (the reverse camera taking over the screen, say), the next line written would
# end this script, and with it the install it's in the middle of: so a closed pipe or a
# hang-up doesn't stop it (install.sh and uninstall.sh do the same, and only start in P).
trap '' HUP PIPE INT TERM
ROOT=${ROOT:-}
STAGE=$ROOT/data/local/tmp/hmgapi-usb

# an app_process build HMG-API hasn't checked (install.sh, uninstall.sh: ASK_BUILD in lib.sh)
UNKNOWN_TOAST="HMG-API hasn't checked your car's software build yet, so nothing was changed. Please open an issue at github.com/Open-HMG/HMG-API with HMGAPI/install.log from this stick."
toast() {
    echo "$1"
    [ -n "$ROOT" ] && return
    am broadcast -a com.hkmc.intent.action.TOAST -e com.hkmc.intent.extra.TOAST_MESSAGE "$1" \
        --ez com.hkmc.intent.extra.TOAST_POPUPSHOWING true >/dev/null 2>&1
}

# restart once the DSP agent has the result; the rest runs from /data (deleting
# /storage/upgrade cuts off this script, which lives there). Not out of P: a restart takes the
# reverse camera's picture away for about a minute, so while HMG-API's vehicle reading says
# the car isn't in P, it waits (no reading, as on a first install: restarts as before).
finish() {
    [ -n "$ROOT" ] && exit "$1"
    sync
    cat > /data/local/tmp/hmgapi-ota-finish.sh << 'END'
#!/system/bin/sh
trap '' HUP PIPE INT TERM
sleep 8
rm -rf /storage/upgrade/*
sync
while [ -x /system/bin/hmgapid ]; do
    set -- $(/system/bin/hmgapid vehicle gear.park 2>/dev/null)
    [ "$1 $2" = "gear.park 0" ] || break
    sleep 5
done
reboot
END
    chmod 755 /data/local/tmp/hmgapi-ota-finish.sh
    exec /data/local/tmp/hmgapi-ota-finish.sh
}

U=
for d in ${HMGAPI_USB_DIRS:-/storage/usb0 /storage/usb1 /storage/usb2 /mnt/media_rw/usb0 /mnt/media_rw/usb1 /mnt/media_rw/usb2}; do
    if [ -d "$d/HMGAPI" ]; then U=$d; break; fi
done
if [ -z "$U" ]; then
    toast "HMG-API: no HMGAPI folder on the USB stick. Nothing was changed."
    finish 1
fi

[ -n "$ROOT" ] || mount -o remount,rw /system >/dev/null 2>&1   # allowed in this process

# HMGAPI/FORCE (install an app_process HMG-API doesn't know yet, and its uninstall) is off for now:
# an unknown build is refused with nothing changed, and its line goes into stock.txt. To put the
# stick file back, uncomment this line and the one in install/nemesis/scripts/postinstall.sh
#[ -f "$U/HMGAPI/FORCE" ] && export HMGAPI_FORCE=1
if [ -f "$U/HMGAPI/UNINSTALL" ] || [ -f "$U/HMGAPI/UNINSTALL-PURGE" ]; then
    if [ ! -f "$ROOT/data/hmgapi/uninstall.sh" ]; then
        toast "HMG-API isn't installed. Nothing was changed."
        finish 1
    fi
    toast "HMG-API: uninstalling. Keep the car in P until the head unit restarts."
    PURGE=
    [ -f "$U/HMGAPI/UNINSTALL-PURGE" ] && PURGE=--purge
    sh "$ROOT/data/hmgapi/uninstall.sh" $PURGE > "$STAGE.log" 2>&1
    rc=$?
    cp "$STAGE.log" "$U/HMGAPI/install.log" 2>/dev/null
    rm -f "$STAGE.log"
    if [ $rc = 0 ]; then toast "HMG-API uninstalled, restarting."
    elif [ $rc = 75 ]; then toast "HMG-API: the car isn't in P, so nothing was changed. Shift to P and start the uninstall again."
    elif grep -q "isn't a known stock build" "$U/HMGAPI/install.log" 2>/dev/null; then toast "$UNKNOWN_TOAST"
    else toast "HMG-API uninstall failed: see HMGAPI/install.log on the stick."; fi
    finish $rc
fi

P=$U/HMGAPI/install/payload
if [ ! -f "$P/MANIFEST" ]; then
    toast "HMG-API: no HMGAPI/install/payload on the USB stick. Nothing was changed."
    finish 1
fi
toast "HMG-API $(cat "$P/VERSION" 2>/dev/null): installing. Keep the car in P until the head unit restarts."
# from /data: the stick may be pulled, and it may not allow running files
rm -r "$STAGE" 2>/dev/null
mkdir -p "${STAGE%/*}" && cp -r "$P" "$STAGE" || { toast "HMG-API: can't copy from the USB stick. Nothing was changed."; finish 1; }
sh "$STAGE/install.sh" "$STAGE" > "$STAGE.log" 2>&1
rc=$?
cp "$STAGE.log" "$U/HMGAPI/install.log" 2>/dev/null
rm -r "$STAGE" "$STAGE.log" 2>/dev/null
if [ $rc = 0 ]; then
    toast "HMG-API installed, restarting."
elif [ $rc = 75 ]; then
    toast "HMG-API: the car isn't in P, so nothing was changed. Shift to P and start the install again."
elif grep -q "isn't a known stock build" "$U/HMGAPI/install.log" 2>/dev/null; then
    toast "$UNKNOWN_TOAST"
else
    toast "HMG-API install failed: see HMGAPI/install.log on the stick."
fi
finish $rc
