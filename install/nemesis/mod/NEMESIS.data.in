[nemesis]
version=1.1
id=@PACKAGE_ID@
name=@NAME@
type=application
package-version=@PACKAGE_VERSION@
short-desc="@SHORT_DESC@"
detailed-desc="@DETAILED_DESC@"
os="@OS@"
models="any"
depends="@DEPENDS@"
preinstall=scripts/preinstall.sh
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=bin/open.sh
uid=root
